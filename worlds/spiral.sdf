<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="spiral">
    
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="spiral">
      <static>true</static>

      <link name="wall_1">
        <pose>1 0 0.25 0 0 0</pose>
        <collision name="c1"><geometry><box><size>0.2 2.0 0.5</size></box></geometry></collision>
        <visual name="v1"><geometry><box><size>0.2 2.0 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.4 1</ambient><diffuse>0.2 0.6 0.4 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_2">
        <pose>0 1 0.25 0 0 0</pose>
        <collision name="c2"><geometry><box><size>2.0 0.2 0.5</size></box></geometry></collision>
        <visual name="v2"><geometry><box><size>2.0 0.2 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.4 1</ambient><diffuse>0.2 0.6 0.4 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_3">
        <pose>-1 -1 0.25 0 0 0</pose>
        <collision name="c3"><geometry><box><size>0.2 4.0 0.5</size></box></geometry></collision>
        <visual name="v3"><geometry><box><size>0.2 4.0 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.4 1</ambient><diffuse>0.2 0.6 0.4 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_4">
        <pose>1 -3 0.25 0 0 0</pose>
        <collision name="c4"><geometry><box><size>4.0 0.2 0.5</size></box></geometry></collision>
